# Copie este arquivo para .env.local e preencha os valores.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# A chave "service_role" (NÃO a "anon public"). Nunca coloque no código.
SUPABASE_SERVICE_ROLE_KEY=

# Senha de acesso ao app. Use uma senha longa (12+ caracteres).
APP_PASSWORD=

# Segredo que assina o cookie de sessão (recomendado). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar este valor desconecta todos os aparelhos.
SESSION_SECRET=
